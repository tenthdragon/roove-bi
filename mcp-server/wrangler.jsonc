{
  // Cloudflare Worker for the Roove BI MCP server (HTTP mode).
  // Deploy:  npm --prefix mcp-server run deploy
  // Bindings (set once as Worker secrets, never committed):
  //   SUPABASE_URL, SUPABASE_ANON_KEY, MCP_WORKSPACE_ID,
  //   SUPABASE_MCP_JWT, MCP_AUTH_TOKEN
  // The Supabase service role key is NOT used by this Worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roove-bi-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
}
